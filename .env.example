# Copy to .env and fill in. .env is gitignored and excluded from the handover zip.
# Values already exported in your shell take precedence over this file.

# Required only when summarizer.backend is anthropic_api.
ANTHROPIC_API_KEY=

# Required only for phase-2 diagnosis. Your unified-admin dashboard session
# token, from localStorage.accessToken. Expires; re-copy when diagnosis says so.
ONCALLBOT_HRA_TOKEN=

# Optional: override config.yaml without editing it. Handy if the whole team
# shares one config.yaml and only the mailbox differs.
# ONCALLBOT_GMAIL_ACCOUNT=your.name@1mg.com
# ONCALLBOT_BACKEND=anthropic_api
# ONCALLBOT_MODEL=sonnet
# ONCALLBOT_LOOKBACK_DAYS=3
# ONCALLBOT_ATTACHMENTS_ENABLED=false
